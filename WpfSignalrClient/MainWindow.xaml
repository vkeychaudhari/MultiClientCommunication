<Window x:Class="WpfSignalrClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSignalrClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBox x:Name="MessageTextBox" Width="300" Margin="5"/>
            <Button Content="Send Message" Click="SendMessage_Click" Margin="5"/>
            <ListBox x:Name="MessagesListBox" Width="300" Height="200" Margin="5"/>
        </StackPanel>

    </Grid>
</Window>
