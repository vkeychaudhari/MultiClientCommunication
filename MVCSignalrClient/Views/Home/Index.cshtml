<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client List</title>
</head>
<body>
    <h1>Client List</h1>
    <ul id="clientList"></ul>

    <script>
        // Function to fetch and update the client list
        function fetchClientList() {
            fetch('/Home/GetClientList')  // Replace with the correct path if needed
                .then(response => response.json())
                .then(data => {
                    const clientListElement = document.getElementById('clientList');
                    clientListElement.innerHTML = ''; // Clear previous list

                    // Loop through the client data and create list items
                    for (let key in data) {
                        if (data.hasOwnProperty(key)) {
                            const listItem = document.createElement('li');
                            listItem.textContent = `Client ID: ${key}, Client Name: ${data[key]}`;
                            clientListElement.appendChild(listItem);
                        }
                    }
                })
                .catch(error => console.error('Error fetching client list:', error));
        }

        // Fetch the client list initially when the page loads
        window.onload = function () {
            fetchClientList(); // Fetch the client list once on load

            // Set an interval to update the client list every 2 seconds
            setInterval(fetchClientList, 2000);  // 2000 ms = 2 seconds
        };
    </script>
</body>
</html>
